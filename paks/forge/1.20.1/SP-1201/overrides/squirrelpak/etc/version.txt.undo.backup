# SquirrelCraft SquirrelPAK Version File - v3.0
#

PAK_RELEASE=0.5.0
PAK_MC_VER=1.20.1


PAK_NAME_INIT_PFX=12
PAK_NAME_INIT=01


# Should replace above one day until then combine them
PAK_NAME="$PAK_NAME_INIT_PFX$PAK_NAME_INIT"

# Desc of the pack
PAK_DESC="Tech Squirrels"

# Req forge version. Should change to loader
PAK_FORGE_VER=47.3.7

# Menu Music Credits
PAK_Menu_R2_Menu_Music_Credits="Party Pirates by Alexander Nakarada (Squirrel Remix)"

# Menu Config Dir
PAK_Menu_Config_Dir="./config/fancymenu/assets/menu-text"

# Beta/Alpha Settings
PAK_IS_BETA=true
PAK_Beta_Text="&cBeta"
PAK_Beta_Header="&cBeta &eVersion &f#5"
PAK_Beta_Tagline="&fIt's &cBeta &fI am sure it will work?"


# Do not change anything below this line!
# - - - - - - - - - - - - - - - - - - - 

# Computed vars
PAK_VER="$PAK_RELEASE-$PAK_MC_VER"
PAK_Menu_R2_Name="&a$PAK_NAME_INIT_PFX$PAK_NAME_INIT"
PAK_Menu_R2_Desc="&f$PAK_DESC"
PAK_Menu_R2_Ver="v$PAK_RELEASE"
PAK_Menu_R2_Full_Name_Ver="&6SquirrelPAK $PAK_Menu_R2_Name &f$PAK_Menu_R2_Ver"



